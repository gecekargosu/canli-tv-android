<?xml version="1.0" encoding="utf-8"?>
<!--
  M-08: Varsayılan olarak yalnız HTTPS.
  Aşağıdaki alan adları, yayıncıların yalnız HTTP üzerinden yayın yaptığı eski
  radyo/kanal adresleridir; bunlar için açık istisna tanımlıdır.
  Yeni kaynak eklerken önce HTTPS olup olmadığına bakılmalıdır.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- v10.03: streamtheworld / radyotvonline / arabeskinmerkezi HTTPS'e tasindi,
             bu uc alan adi icin istisna KALDIRILDI. Asagidakiler yalniz HTTP yayin
             yapiyor (HTTPS denendi: TLS yok / sertifika gecersiz). -->
        <domain includeSubdomains="true">rtmp.org</domain>
        <domain includeSubdomains="true">live.net.sa</domain>
        <domain includeSubdomains="true">46.20.3.207</domain>
        <domain includeSubdomains="true">46.20.3.250</domain>
    </domain-config>
</network-security-config>
